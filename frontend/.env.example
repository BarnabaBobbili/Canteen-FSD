# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================

# ================================
# AUTHENTICATION
# ================================
# Google OAuth Client ID
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ================================
# BACKEND API CONNECTION
# ================================
# API Base URL - Points to your backend server
# Development: http://localhost:5001/api
# Production: https://your-backend-app.onrender.com/api (or your deployment URL)
VITE_API_URL=http://localhost:5001/api

# ================================
# PAYMENT GATEWAY (Razorpay - India)
# ================================
# Razorpay Key ID (Public key - safe to expose in frontend)
# Get from: https://dashboard.razorpay.com/app/keys
# Test Mode Key - Replace with live key in production
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# ================================
# SETUP INSTRUCTIONS
# ================================
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to version control (already in .gitignore)
#
# Required:
# - VITE_API_URL (must match your backend URL)
#
# Optional:
# - VITE_GOOGLE_CLIENT_ID (Google OAuth login)
# - VITE_RAZORPAY_KEY_ID (Online payments)
#
# IMPORTANT: Do NOT add backend secrets (email passwords, API keys) here!
