# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/canteen
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/canteen

# Server Configuration
PORT=5001

# JWT Secret Key (change this in production!)
JWT_SECRET=your-secret-key-change-in-production-environment

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
