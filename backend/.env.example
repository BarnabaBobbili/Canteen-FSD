# ================================
# DATABASE CONFIGURATION
# ================================
MONGODB_URI=mongodb://localhost:27017/canteen
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/canteen

# ================================
# SERVER CONFIGURATION
# ================================
PORT=5001
NODE_ENV=development

# ================================
# AUTHENTICATION
# ================================
# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production-environment-a8f9d3e2b7c4a1f0

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ================================
# EMAIL NOTIFICATIONS (Gmail)
# ================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
# Get Gmail App Password: https://myaccount.google.com/apppasswords
# Note: Requires 2FA enabled on your Google account

# ================================
# SMS NOTIFICATIONS (Fast2SMS - India)
# ================================
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=TXTIND
# Get API key: https://www.fast2sms.com/ → Dashboard → Dev API
# Free credits available for testing!

# ================================
# FRONTEND INTEGRATION
# ================================
# Frontend URL for CORS and tracking links
# Development: http://localhost:3000
# Production: https://your-frontend-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ================================
# PAYMENT GATEWAY (Razorpay - India)
# ================================
# Get from: https://dashboard.razorpay.com/app/keys
# Test Mode Keys - Replace with live keys in production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ================================
# SETUP CHECKLIST
# ================================
# Required for basic functionality:
# ✅ MONGODB_URI
# ✅ JWT_SECRET
# ✅ EMAIL_USER, EMAIL_PASSWORD (for order notifications)
#
# Optional (features disabled if not configured):
# ⚪ FAST2SMS_API_KEY (SMS notifications will be skipped)
# ⚪ GOOGLE_CLIENT_ID (Google OAuth login will be disabled)
# ⚪ RAZORPAY_KEY_ID/SECRET (Online payments will be disabled)
